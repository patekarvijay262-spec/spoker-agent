# Required
CRUSTDATA_API_KEY=                         # app.crustdata.com: company, people and web data.
DATABASE_URL=                              # added automatically by the Vercel Neon integration
# Sign-in with Google, and Gmail sending (one Google Cloud OAuth client, type Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URIs to register in Google Cloud:
#   https://<your-app>.vercel.app/api/auth/google/callback   (sign-in)
#   https://<your-app>.vercel.app/api/google/callback        (Gmail)
# Recommended
CRON_SECRET=                               # any random string; Vercel cron sends it as a Bearer token
TOKEN_KEY=                                 # encrypts stored Google and Instagram tokens (falls back to APP_PASSWORD)
# Optional
SARVAM_API_KEY=                            # dashboard.sarvam.ai: voice control, Indian languages, the discovery strategist
GEMINI_API_KEY=                            # aistudio.google.com: more conversational assistant answers
SD_COUNTRY=IND                             # where to discover sponsors (Crustdata country code, e.g. IND, USA, GBR)
APP_PASSWORD=                              # only a fallback login if Google sign-in is not set up yet
# Instagram (official API, read-only): lets an organiser connect their Business or Creator account
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Redirect URI to register in the Meta app: https://<your-app>.vercel.app/api/instagram/callback
